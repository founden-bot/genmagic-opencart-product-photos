{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save|e }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back|e }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title|e }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text|e }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit|e }}</div>
      <div class="card-body">
        <p>{{ text_intro|e }}</p>
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status|e }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_genmagic_photos_status" value="0"/>
                <input type="checkbox" name="module_genmagic_photos_status" value="1" id="input-status" class="form-check-input"{% if module_genmagic_photos_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key|e }}</label>
            <div class="col-sm-10">
              <input type="password" name="module_genmagic_photos_api_key" value="" id="input-api-key" class="form-control" maxlength="200" autocomplete="new-password" spellcheck="false" placeholder="{% if has_key %}{{ text_key_saved|e }}{% else %}{{ entry_api_key|e }}{% endif %}"/>
              <div id="error-api-key" class="invalid-feedback"></div>
              <div class="form-text">{{ help_api_key|e }} <a href="{{ key_url|e }}" target="_blank" rel="noopener noreferrer">{{ text_get_key|e }}</a> | <a href="{{ pricing_url|e }}" target="_blank" rel="noopener noreferrer">{{ text_add_credit|e }}</a></div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_consent|e }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_genmagic_photos_consent" value="0"/>
                <input type="checkbox" name="module_genmagic_photos_consent" value="1" id="input-consent" class="form-check-input"{% if module_genmagic_photos_consent %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_consent|e }}</div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
